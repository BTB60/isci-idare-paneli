# Bu faylı backend/.env kimi saxlayın (server həmişə backend/.env oxuyur — iş qovluğundan asılı deyil).
# Server Configuration
PORT=5000
NODE_ENV=development

# CORS / Socket.io allowed origins (comma-separated). Empty = defaults by NODE_ENV.
# CORS_ORIGINS=https://555insaat.az,https://www.555insaat.az,https://myapp.onrender.com

# MongoDB (boş buraxın və ya yerli Mongo yoxdursa server in-memory Mongo işə salır — yalnız development)
# USE_MEMORY_DB=1
# Köhnə demo hesabları DB-dən silmək: npm run purge-demo-users
# İlk admin CLI: npm run create-admin -- email@sirket.az Sifre123 "Tam Ad"
MONGODB_URI=mongodb://127.0.0.1:27017/555_insaat

# JWT — production-da JWT_SECRET ən azı 32 simvol, təsadüfi; nümunə sətirlər qəbul olunmur
# Render.com/Docker: .env image-da olmur — Dashboard → Environment-da JWT_SECRET təyin edin (npm run gen:jwt-secrets)
JWT_SECRET=
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRE=30d

# Auth rate limit (opsional)
# AUTH_LOGIN_RATE_MAX=25
# AUTH_LOGIN_WINDOW_MS=900000
# AUTH_REGISTER_RATE_MAX=15

# Production: ictimai POST /api/auth/register — yalnız bir dəfə admin yaratmaq üçün 1 təyin edin, sonra söndürün
# ALLOW_PUBLIC_REGISTER=1

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Push Notifications (VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@555insaat.az

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session
SESSION_SECRET=your_session_secret_here
SESSION_TIMEOUT=1800000
